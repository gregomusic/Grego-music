@charset "utf-8";

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { background: rgb(9, 9, 9); color: white; font-family: Arial, sans-serif; }

.app { max-width: 500px; margin: auto; padding-bottom: 90px; }

header { padding: 25px 20px; text-align: center; }

header h1 { font-size: 30px; letter-spacing: 2px; }

header h1 span { color: rgb(255, 208, 0); }

header p { color: rgb(153, 153, 153); margin-top: 8px; }

.search { margin: 5px 20px 25px; background: rgb(27, 27, 27); padding: 14px; border-radius: 30px; }

.search input { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; color: white; font-size: 15px; width: 85%; }

section { padding: 0px 20px; margin-bottom: 28px; }

h2 { font-size: 20px; margin-bottom: 15px; }

.featured { background: linear-gradient(135deg, rgb(59, 48, 0), rgb(23, 23, 23)); border-radius: 18px; padding: 18px; display: flex; align-items: center; gap: 15px; }

.cover { width: 110px; height: 110px; background: linear-gradient(135deg, rgb(255, 208, 0), rgb(255, 123, 0)); border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 45px; }

.featured h3 { margin-bottom: 8px; }

.featured p { color: rgb(170, 170, 170); margin-bottom: 15px; }

button { background: rgb(255, 208, 0); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 20px; padding: 10px 15px; font-weight: bold; }

.music { background: rgb(22, 22, 22); padding: 12px; margin-bottom: 10px; border-radius: 12px; display: flex; align-items: center; gap: 12px; }

.mini-cover { width: 55px; height: 55px; border-radius: 10px; background: rgb(41, 41, 41); display: flex; align-items: center; justify-content: center; font-size: 24px; }

.music div:nth-child(2) { flex: 1 1 0%; }

.music p { color: rgb(136, 136, 136); font-size: 13px; margin-top: 5px; }

nav { position: fixed; bottom: 0px; left: 0px; right: 0px; background: rgb(21, 21, 21); border-top: 1px solid rgb(41, 41, 41); display: flex; justify-content: space-around; padding: 12px 5px; }

nav div { text-align: center; color: rgb(255, 208, 0); font-size: 20px; }

nav small { display: block; font-size: 11px; color: rgb(170, 170, 170); margin-top: 4px; }

.player-info { flex: 1 1 0%; }

.player-info strong { color: white; font-size: 14px; }

.player-info p { color: rgb(136, 136, 136); font-size: 12px; margin-top: 4px; }

.player button { background: rgb(255, 208, 0); color: rgb(17, 17, 17); width: 42px; height: 42px; border-radius: 50%; padding: 0px; font-size: 18px; }
